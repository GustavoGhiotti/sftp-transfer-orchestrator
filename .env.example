# =====================================================================
#  .env.example  —  copie para .env e preencha com os valores reais.
#  NUNCA versione o .env (ja esta no .gitignore).
# =====================================================================

# ---- Banco de dados (1 USUARIO unico para TODAS as tabelas) --------
# Mesmo servidor e usuario; muda so o nome do banco entre config e logs.
#   DB_SFTP  -> TB_CONEXAO_SFTP, TB_ARQUIVO_MAPA, TB_TRANSFERENCIAS
#   LOGS_ROBOS -> TB_LOG_EXECUCAO
DB_SERVER=10.0.0.66
DB_USER=
DB_PASSWORD=
DB_SFTP_DATABASE=DB_SFTP
DB_LOGS_DATABASE=LOGS_ROBOS
# Driver ODBC (opcional). Se vazio, o robo escolhe o melhor instalado
# (ODBC Driver 18/17 > Native Client > "SQL Server" legado).
# Force um especifico se precisar, ex.: ODBC Driver 17 for SQL Server
# DB_DRIVER=ODBC Driver 17 for SQL Server

# ---- SMB (varios file servers; cada um com seu usuario) ------------
# Usado sempre que o caminho (ORIGEM/DESTINO) for UNC (comeca com \\).
# O servidor e detectado pelo IP no caminho \\10.0.0.XX\...
# Liste os IPs e defina SMB_<ultimo_octeto>_USER / _PASSWORD para cada um.
SMB_SERVERS=10.0.0.64,10.0.0.71,10.0.0.72
SMB_64_USER=
SMB_64_PASSWORD=
SMB_71_USER=
SMB_71_PASSWORD=
SMB_72_USER=
SMB_72_PASSWORD=

# ---- Execucao ------------------------------------------------------
# Numero de transferencias simultaneas no pool
MAX_WORKERS=4
# Tamanho do bloco de leitura/gravacao em MB (stream origem -> destino)
CHUNK_MB=64
# Checagem "arquivo pronto" (tamanho estavel antes de baixar).
# Total de espera por arquivo ~= TENTATIVAS_ARQUIVO * ESPERA_ARQUIVO_SEG.
# Diminua para testes rapidos (ex.: 2 e 3); mantenha alto em producao.
TENTATIVAS_ARQUIVO=3
ESPERA_ARQUIVO_SEG=15

# ---- Modo de teste -------------------------------------------------
# Ligado (true), TODOS os destinos vao para DESTINO_TESTE em vez do destino
# real. A tabela NAO muda e a ORIGEM continua a real (voce testa puxando de
# verdade). A estrutura original e preservada embaixo de DESTINO_TESTE, ex.:
#   real  \\10.0.0.64\arquivos\entrada
#   teste \\10.0.0.72\teste\10.0.0.64\arquivos\entrada
# Se DESTINO_TESTE for um SMB, o servidor dele precisa estar em SMB_SERVERS.
MODO_TESTE=false
DESTINO_TESTE=\\10.0.0.72\teste

# ---- Chaves .pem do SFTP -------------------------------------------
# Por padrao o robo procura as chaves na pasta 'chaves/' dentro do projeto,
# entao ARQUIVO_CHAVE na TB_CONEXAO_SFTP pode ser so o nome (ex.: cedente_77.pem).
# Descomente para usar outra pasta:
# PASTA_CHAVES=C:\Robos\chaves


# --- demais variaveis lidas pelo codigo ---
DB_DRIVER=DB_EXEMPLO
PASTA_CHAVES=./data
